# Copia este archivo como .env y ajusta los valores. .env está ignorado por git.

# Dirección en la que el servicio app expone el puerto 8080.
# 127.0.0.1 (por defecto): solo esta máquina. 0.0.0.0: toda la red local.
BIND_IP=127.0.0.1

# Solo el workflow nocturno lo pone en true: corre los Real*ContractIT contra Ollama y PostgreSQL reales.
CONTRACT_REAL=false

# Zona horaria de la aplicación (fechas de revisión, auditoría).
APP_ZONA=America/Bogota

# Los secretos NO van aquí: van en secrets/db_password.txt y secrets/admin_pin.txt (ver secrets/README.md).
