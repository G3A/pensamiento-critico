# Copia este archivo como .env y ajusta los valores. .env está ignorado por git.
# Son todas las variables que leen docker-compose.yml y docker-compose.ci.yml. Cada una dice en qué hito nació y dónde
# está la decisión que la explica (README, tablas "Decisiones tomadas en el hito N" y "Variables de entorno").

# Hito 0 · Dirección en la que el servicio app expone el puerto 8080 (README, "Casa con llave").
# 127.0.0.1 (por defecto): solo esta máquina. Hito 8: déjala así; el servicio sale a internet solo detrás de un proxy
# con certificado (lista de la salida a internet), nunca con el puerto de la app abierto.
BIND_IP=127.0.0.1

# Hito 0 · Solo el workflow nocturno lo pone en true: corre los Real*ContractIT contra Ollama y PostgreSQL reales
# (README, decisiones del hito 0; .github/workflows/nocturno.yml).
CONTRACT_REAL=false

# Hito 0 · Zona horaria de la aplicación (fechas de revisión del Diario, auditoría).
APP_ZONA=America/Bogota

# Hito 4 · Solo para pruebas de aceptación y demostraciones: el administrador puede adelantar el reloj de la aplicación
# (POST /administracion/reloj?dias=N) para ver vencer una revisión del Diario. La aceptación del flujo D
# (FlujoDDiarioDeDecisionesIT, RNF09DiarioEnNavegadorIT) lo necesita en true; docker-compose.ci.yml lo activa en CI.
# En una instalación real, déjalo en false (README, decisiones del hito 4).
APP_RELOJ_AJUSTABLE=false

# Hito 0 · Los secretos NO van aquí: van en secrets/db_password.txt, secrets/operador_clave.txt y
# secrets/respaldo_clave.txt (hito 8; ver secrets/README.md).

# Hito 0 · Opcional: clave gratuita de la API de NVD (https://nvd.nist.gov/developers/request-an-api-key).
# Sin ella, Dependency-Check en -Pgates descarga la base completa sin clave (unos 30 minutos la primera vez).
NVD_API_KEY=
